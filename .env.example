# Browser-safe frontend configuration only; never place secrets in VITE_* variables.
# Leave the base blank to use relative API routes. Vite proxies /api and /health in development.
VITE_API_BASE_URL=
VITE_ANALYZE_ENDPOINT=/api/v1/analyze
VITE_DASHBOARD_ENDPOINT=/api/v1/dashboard
VITE_HEALTH_ENDPOINT=/health

# Backend/development-server configuration. These values are read at runtime, not embedded in the browser.
FASTAPI_PROXY_TARGET=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
